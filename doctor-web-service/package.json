  "scripts": {
    "start": "craco start",
    "test": "craco test",
    "eject": "react-scripts eject",
    "winBuild": "set \"GENERATE_SOURCEMAP=false\" && craco build",
    "start:development": "env-cmd -f .env.development craco start",
    "start:staging": "env-cmd -f .env.staging craco start",
    "start:production": "env-cmd -f .env.production craco start",
    "build:development": "env-cmd -f .env.development craco build --verbose",
    "build:staging": "env-cmd -f .env.staging craco build",
    "build:production": "env-cmd -f .env.production craco build",
    "analyze": "ANALYZE=true npm run build:production",
    "start:server": "serve -s build",
    "format": "prettier --write .",
    "prepare": "husky install",
    "prettier:check": "prettier --check . ",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "cspell:check": "cspell --quiet"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@craco/craco": "^7.1.0",
    "@testing-library/jest-dom": "^5.14.1",
